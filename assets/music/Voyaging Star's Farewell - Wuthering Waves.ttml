      <p begin="01:10.660" end="01:13.510"><span begin="01:10.660" end="01:11.135">May</span> <span begin="01:11.135" end="01:11.768">your</span> <span begin="01:11.768" end="01:12.402">path</span> <span begin="01:12.402" end="01:12.718">be</span> <span begin="01:12.718" end="01:13.510">clear</span></p>
      <p begin="01:13.510" end="01:20.550"><span begin="01:13.510" end="01:13.959">May</span> <span begin="01:13.959" end="01:14.409">you</span> <span begin="01:14.409" end="01:14.858">get</span> <span begin="01:14.858" end="01:15.158">to</span> <span begin="01:15.158" end="01:15.907">where</span> <span begin="01:15.907" end="01:16.805">dreams</span> <span begin="01:16.805" end="01:17.255">are</span> <span begin="01:17.255" end="01:17.704">all</span> <span begin="01:17.704" end="01:19.352">crystalline</span> <span begin="01:19.352" end="01:19.801">and</span> <span begin="01:19.801" end="01:20.550">sweet</span></p>
      <p begin="01:20.550" end="01:24.950"><span begin="01:20.550" end="01:21.698">Please</span> <span begin="01:21.698" end="01:22.654">crack</span> <span begin="01:22.654" end="01:22.846">a</span> <span begin="01:22.846" end="01:23.993">littlе</span> <span begin="01:23.993" end="01:24.950">smile</span></p>
      <p begin="01:24.950" end="01:27.430"><span begin="01:24.950" end="01:25.446">You</span> <span begin="01:25.446" end="01:26.273">won't</span> <span begin="01:26.273" end="01:26.603">be</span> <span begin="01:26.603" end="01:27.430">alone</span></p>
