<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:composer="https://composer.betterlyrics.org/ttml" ttp:timeBase="media" xml:lang="en" itunes:timing="Word" composer:timing="Word"><head><metadata><ttm:title>A Small Miracle [bPS8Ii6Ef14]</ttm:title><composer:meta key="artists" value="Wuthering Waves, jixwang, Fleet Snowfluff"/><composer:meta key="album" value="The Night the Stars Left No Trail(Original Game Soundtrack)"/><ttm:agent xml:id="v1" type="person"><ttm:name>Lead</ttm:name></ttm:agent><ttm:agent xml:id="v2000" type="other"><ttm:name>Chorus</ttm:name></ttm:agent><composer:groups><composer:group id="g1" label="Group 1" color="#f472b6" templateVersion="1"/></composer:groups></metadata></head><body dur="4:22.643"><div><p begin="0:22.233" end="0:26.859" ttm:agent="v1" key="archivetune-translation-0"><span begin="0:22.233" end="0:22.803">Isn't</span> <span begin="0:22.803" end="0:23.951">it</span> <span begin="0:23.951" end="0:24.484">so</span> <span begin="0:24.484" end="0:26.859">incredible</span></p><p begin="0:26.798" end="0:32.716" ttm:agent="v1" key="archivetune-translation-1"><span begin="0:26.798" end="0:27.085">We're</span> <span begin="0:27.085" end="0:27.652">here</span> <span begin="0:27.652" end="0:29.356">sharing</span> <span begin="0:29.356" end="0:29.643">the</span> <span begin="0:29.643" end="0:30.172">same</span> <span begin="0:30.172" end="0:31.006">time</span> <span begin="0:31.006" end="0:31.574">and</span> <span begin="0:31.574" end="0:32.716">space</span></p><p begin="0:32.844" end="0:37.417" ttm:agent="v1" key="archivetune-translation-2"><span begin="0:32.844" end="0:32.987">In</span> <span begin="0:32.987" end="0:33.539">your</span> <span begin="0:33.539" end="0:34.689">eyes,</span> <span begin="0:34.689" end="0:34.948">the</span> <span begin="0:34.948" end="0:35.545">sparks</span> <span begin="0:35.545" end="0:36.066">look</span> <span begin="0:36.066" end="0:37.417">like</span></p><p begin="0:37.417" end="0:43.621" ttm:agent="v1" key="archivetune-translation-3"><span begin="0:37.417" end="0:38.286">Thousands</span> <span begin="0:38.286" end="0:38.725">of</span> <span begin="0:38.725" end="0:39.192">bright</span> <span begin="0:39.192" end="0:40.088">stars</span> <span begin="0:40.130" end="0:40.222">I</span> <span begin="0:40.222" end="0:40.478">have</span> <span begin="0:40.478" end="0:40.767">gazed</span> <span begin="0:40.767" end="0:41.051">at</span> <span begin="0:41.051" end="0:41.335">for</span> <span begin="0:41.335" end="0:41.625">thousands</span> <span begin="0:41.625" end="0:42.768">of</span> <span begin="0:42.768" end="0:43.621">time</span></p><p begin="0:43.621" end="0:46.310" ttm:agent="v1" key="archivetune-translation-4"><span begin="0:43.621" end="0:43.908">May</span> <span begin="0:43.908" end="0:44.195">all</span> <span begin="0:44.195" end="0:44.475">your</span> <span begin="0:44.475" end="0:44.759">sweet</span> <span begin="0:44.759" end="0:45.042">dreams</span> <span begin="0:45.042" end="0:45.329">take</span> <span begin="0:45.329" end="0:46.310">flight</span></p><p begin="0:46.310" end="0:48.588" ttm:agent="v1" key="archivetune-translation-5"><span begin="0:46.310" end="0:46.496">With</span> <span begin="0:46.496" end="0:46.704">the</span> <span begin="0:46.704" end="0:46.844">truth</span> <span begin="0:46.844" end="0:47.009">to</span> <span begin="0:47.009" end="0:47.231">be</span> <span begin="0:47.231" end="0:47.530">your</span> <span begin="0:47.530" end="0:48.009">guiding</span> <span begin="0:48.009" end="0:48.588">light</span></p><p begin="0:48.686" end="0:54.301" ttm:agent="v1" key="archivetune-translation-6"><span begin="0:48.686" end="0:49.255">Let</span> <span begin="0:49.255" end="0:49.786">your</span> <span begin="0:49.786" end="0:50.978">curiosity</span> <span begin="0:50.978" end="0:51.216">set</span> <span begin="0:51.216" end="0:51.499">your</span> <span begin="0:51.499" end="0:51.783">spirit</span> <span begin="0:51.783" end="0:52.067">free</span> <span begin="0:52.067" end="0:52.152">and</span> <span begin="0:52.152" end="0:52.594">wild</span> <span begin="0:52.594" end="0:53.164">like</span> <span begin="0:53.164" end="0:54.301">fire</span></p><p begin="0:54.307" end="0:57.161" ttm:agent="v1" key="archivetune-translation-7"><span begin="0:54.307" end="0:54.591">If</span> <span begin="0:54.591" end="0:54.874">the</span> <span begin="0:54.874" end="0:55.164">lonely</span> <span begin="0:55.164" end="0:55.448">nights</span> <span begin="0:55.448" end="0:55.731">are</span> <span begin="0:55.731" end="0:56.017">price</span> <span begin="0:56.017" end="0:56.210">to</span> <span begin="0:56.210" end="0:57.161">see</span></p><p begin="0:57.161" end="0:59.155" ttm:agent="v1" key="archivetune-translation-8"><span begin="0:57.161" end="0:57.323">Our</span> <span begin="0:57.323" end="0:57.731">dreams</span> <span begin="0:57.731" end="0:58.298">glowing</span> <span begin="0:58.298" end="0:59.155">brightly</span></p><p begin="0:59.243" end="1:03.517" ttm:agent="v1" key="archivetune-translation-9"><span begin="0:59.243" end="1:00.100">Every</span> <span begin="1:00.100" end="1:01.240">second</span> <span begin="1:01.240" end="1:01.807">is</span> <span begin="1:01.807" end="1:02.945">worth</span> <span begin="1:02.945" end="1:03.517">it</span></p><p begin="1:03.517" end="1:08.900" ttm:agent="v1" composer:groupId="g1" composer:instanceIdx="0" composer:templateLineIdx="0" key="archivetune-translation-10"><span begin="1:03.517" end="1:03.801">You</span> <span begin="1:03.801" end="1:04.084">built</span> <span begin="1:04.084" end="1:04.370">a</span> <span begin="1:04.370" end="1:05.108">world</span> <span begin="1:05.108" end="1:05.340">of</span> <span begin="1:05.340" end="1:06.659">miracles</span> <span begin="1:06.659" end="1:06.944">so</span> <span begin="1:06.944" end="1:07.509">mundane</span> <span begin="1:07.509" end="1:07.793">but</span> <span begin="1:07.793" end="1:08.900">precious</span></p><p begin="1:08.900" end="1:14.025" ttm:agent="v1" composer:groupId="g1" composer:instanceIdx="0" composer:templateLineIdx="1" key="archivetune-translation-11"><span begin="1:08.900" end="1:09.188">The</span> <span begin="1:09.188" end="1:09.471">stream</span> <span begin="1:09.471" end="1:09.644">of</span> <span begin="1:09.644" end="1:10.299">shimmering</span> <span begin="1:10.299" end="1:11.150">daily</span> <span begin="1:11.150" end="1:12.007">moments</span> <span begin="1:12.007" end="1:12.590">returned</span> <span begin="1:12.590" end="1:13.159">weight</span> <span begin="1:13.159" end="1:13.444">to</span> <span begin="1:13.444" end="1:13.724">my</span> <span begin="1:13.724" end="1:14.025">soul</span></p><p begin="1:14.052" end="1:16.009" ttm:agent="v1" composer:groupId="g1" composer:instanceIdx="0" composer:templateLineIdx="2" key="archivetune-translation-12"><span begin="1:14.052" end="1:14.337">And</span> <span begin="1:14.337" end="1:14.620">stopped</span> <span begin="1:14.620" end="1:15.090">me</span> <span begin="1:15.090" end="1:15.269">from</span> <span begin="1:15.269" end="1:16.009">drifting</span></p><p begin="1:16.009" end="1:18.834" ttm:agent="v1" composer:groupId="g1" composer:instanceIdx="0" composer:templateLineIdx="3" key="archivetune-translation-13"><span begin="1:16.009" end="1:16.296">Gave</span> <span begin="1:16.296" end="1:16.581">my</span> <span begin="1:16.581" end="1:16.870">feet</span> <span begin="1:16.870" end="1:17.156">the</span> <span begin="1:17.156" end="1:17.727">solid</span> <span begin="1:17.727" end="1:17.968">ground</span> <span begin="1:17.968" end="1:18.256">to</span> <span begin="1:18.256" end="1:18.834">stand</span></p><p begin="1:18.834" end="1:20.513" ttm:agent="v1" composer:groupId="g1" composer:instanceIdx="0" composer:templateLineIdx="4" key="archivetune-translation-14"><span begin="1:18.834" end="1:18.968">So</span> <span begin="1:18.968" end="1:19.117">let's</span> <span begin="1:19.117" end="1:19.406">sing</span> <span begin="1:19.406" end="1:20.513">together</span></p><p begin="1:20.293" end="1:23.983" ttm:agent="v1" composer:groupId="g1" composer:instanceIdx="0" composer:templateLineIdx="5" key="archivetune-translation-15"><span begin="1:20.293" end="1:20.861">Every</span> <span begin="1:20.861" end="1:21.150">light</span> <span begin="1:21.150" end="1:21.721">I'm</span> <span begin="1:21.721" end="1:22.010">giving</span> <span begin="1:22.010" end="1:22.578">all</span> <span begin="1:22.578" end="1:23.120">comes</span> <span begin="1:23.120" end="1:23.406">back</span> <span begin="1:23.406" end="1:23.694">to</span> <span begin="1:23.694" end="1:23.983">you</span></p><p begin="1:23.983" end="1:30.308" ttm:agent="v1" composer:groupId="g1" composer:instanceIdx="0" composer:templateLineIdx="6" key="archivetune-translation-16"><span begin="1:23.983" end="1:24.549">Comes</span> <span begin="1:24.549" end="1:24.834">back</span> <span begin="1:24.834" end="1:25.691">to</span> <span begin="1:25.691" end="1:30.308">you</span></p><p begin="1:47.447" end="1:51.930" ttm:agent="v1" key="archivetune-translation-17"><span begin="1:47.447" end="1:47.733">Like</span> <span begin="1:47.733" end="1:49.155">diamonds,</span> <span begin="1:49.155" end="1:49.438">they</span> <span begin="1:49.438" end="1:49.721">need</span> <span begin="1:49.721" end="1:49.908">a</span> <span begin="1:49.908" end="1:50.256">light</span> <span begin="1:50.256" end="1:50.825">to</span> <span begin="1:50.825" end="1:51.930">shine</span></p><p begin="1:51.930" end="1:58.090" ttm:agent="v1" key="archivetune-translation-18"><span begin="1:51.930" end="1:52.212">I</span> <span begin="1:52.212" end="1:52.745">was</span> <span begin="1:52.745" end="1:53.033">a</span> <span begin="1:53.033" end="1:54.742">shadow</span> <span begin="1:54.742" end="1:55.557">until</span> <span begin="1:55.557" end="1:56.135">you</span> <span begin="1:56.135" end="1:56.418">looked</span> <span begin="1:56.418" end="1:56.986">my</span> <span begin="1:56.986" end="1:58.090">way</span></p><p begin="1:58.090" end="2:02.626" ttm:agent="v1" key="archivetune-translation-19"><span begin="1:58.090" end="1:58.382">The</span> <span begin="1:58.382" end="2:00.069">rainbows</span> <span begin="2:00.069" end="2:00.343">I</span> <span begin="2:00.343" end="2:00.912">held</span> <span begin="2:00.912" end="2:02.626">inside</span></p><p begin="2:02.596" end="2:09.110" ttm:agent="v1" key="archivetune-translation-20"><span begin="2:02.596" end="2:03.165">Got</span> <span begin="2:03.165" end="2:03.450">kissed</span> <span begin="2:03.450" end="2:03.733">by</span> <span begin="2:03.733" end="2:05.459">sunshine,</span> <span begin="2:05.459" end="2:05.620">now</span> <span begin="2:05.620" end="2:05.813">they</span> <span begin="2:05.813" end="2:06.013">can</span> <span begin="2:06.013" end="2:06.543">fly</span> <span begin="2:06.543" end="2:06.828">in</span> <span begin="2:06.828" end="2:07.111">the</span> <span begin="2:07.111" end="2:07.965">flowery</span> <span begin="2:07.965" end="2:09.110">skies</span></p><p begin="2:09.092" end="2:11.646" ttm:agent="v1" key="archivetune-translation-21"><span begin="2:09.092" end="2:09.270">Rhythms</span> <span begin="2:09.270" end="2:09.670">were</span> <span begin="2:09.670" end="2:09.961">beating</span> <span begin="2:09.961" end="2:10.532">in</span> <span begin="2:10.532" end="2:10.783">my</span> <span begin="2:10.783" end="2:11.646">heart</span></p><p begin="2:11.746" end="2:14.274" ttm:agent="v1" key="archivetune-translation-22"><span begin="2:11.746" end="2:12.032">Tunes</span> <span begin="2:12.032" end="2:12.602">were ringing</span> <span begin="2:12.602" end="2:12.889">in</span> <span begin="2:12.889" end="2:13.133">my ears</span> <span begin="2:13.133" end="2:14.274">non-stop</span></p><p begin="2:14.274" end="2:16.473" ttm:agent="v1" key="archivetune-translation-23"><span begin="2:14.274" end="2:14.846">That</span> <span begin="2:14.846" end="2:15.423">moment</span> <span begin="2:15.423" end="2:15.473">I</span> <span begin="2:15.473" end="2:15.901">found</span> <span begin="2:15.901" end="2:16.473">you</span></p><p begin="2:16.473" end="2:19.662" ttm:agent="v1" key="archivetune-translation-24"><span begin="2:16.473" end="2:16.591">They</span> <span begin="2:16.591" end="2:16.800">turned</span> <span begin="2:16.800" end="2:16.959">into</span> <span begin="2:16.959" end="2:17.086">a</span> <span begin="2:17.086" end="2:17.664">song</span> <span begin="2:17.664" end="2:17.806">that</span> <span begin="2:17.806" end="2:17.953">I</span> <span begin="2:17.953" end="2:18.520">could</span> <span begin="2:18.520" end="2:18.806">sing</span> <span begin="2:18.806" end="2:19.662">out</span></p><p begin="2:19.877" end="2:22.425" ttm:agent="v1" key="archivetune-translation-25"><span begin="2:19.877" end="2:20.025">If</span> <span begin="2:20.025" end="2:20.169">it</span> <span begin="2:20.169" end="2:20.455">takes</span> <span begin="2:20.455" end="2:20.746">all</span> <span begin="2:20.746" end="2:21.030">those</span> <span begin="2:21.030" end="2:21.599">lonely</span> <span begin="2:21.599" end="2:22.425">nights</span></p><p begin="2:22.425" end="2:25.001" ttm:agent="v1" key="archivetune-translation-26"><span begin="2:22.425" end="2:22.711">Just</span> <span begin="2:22.711" end="2:22.997">to</span> <span begin="2:22.997" end="2:23.568">see</span> <span begin="2:23.568" end="2:23.854">you</span> <span begin="2:23.854" end="2:24.139">smile</span> <span begin="2:24.139" end="2:25.001">tonight</span></p><p begin="2:25.001" end="2:28.680" ttm:agent="v1" key="archivetune-translation-27"><span begin="2:25.001" end="2:25.286">Then</span> <span begin="2:25.286" end="2:25.812">it's</span> <span begin="2:25.812" end="2:26.364">all</span> <span begin="2:26.687" end="2:26.955">been</span> <span begin="2:26.955" end="2:28.378">worth</span> <span begin="2:28.378" end="2:28.680">it</span></p><p begin="2:29.079" end="2:34.461" ttm:agent="v1" composer:groupId="g1" composer:instanceIdx="1" composer:templateLineIdx="0" key="archivetune-translation-28"><span begin="2:29.079" end="2:29.360">You</span> <span begin="2:29.360" end="2:29.645">built</span> <span begin="2:29.645" end="2:29.931">a</span> <span begin="2:29.931" end="2:30.669">world</span> <span begin="2:30.669" end="2:30.902">of</span> <span begin="2:30.902" end="2:32.221">miracles</span> <span begin="2:32.221" end="2:32.503">so</span> <span begin="2:32.503" end="2:33.069">mundane</span> <span begin="2:33.069" end="2:33.354">but</span> <span begin="2:33.354" end="2:34.461">precious</span></p><p begin="2:34.461" end="2:39.586" ttm:agent="v1" composer:groupId="g1" composer:instanceIdx="1" composer:templateLineIdx="1" key="archivetune-translation-29"><span begin="2:34.461" end="2:34.750">The</span> <span begin="2:34.750" end="2:35.032">stream</span> <span begin="2:35.032" end="2:35.205">of</span> <span begin="2:35.205" end="2:35.860">shimmering</span> <span begin="2:35.860" end="2:36.711">daily</span> <span begin="2:36.711" end="2:37.568">moments</span> <span begin="2:37.568" end="2:38.151">returned</span> <span begin="2:38.151" end="2:38.718">weight</span> <span begin="2:38.718" end="2:39.006">to</span> <span begin="2:39.006" end="2:39.288">my</span> <span begin="2:39.288" end="2:39.586">soul</span></p><p begin="2:39.614" end="2:41.569" ttm:agent="v1" composer:groupId="g1" composer:instanceIdx="1" composer:templateLineIdx="2" key="archivetune-translation-30"><span begin="2:39.614" end="2:39.899">And</span> <span begin="2:39.899" end="2:40.181">stopped</span> <span begin="2:40.181" end="2:40.651">me</span> <span begin="2:40.651" end="2:40.830">from</span> <span begin="2:40.830" end="2:41.569">drifting</span></p><p begin="2:41.569" end="2:44.395" ttm:agent="v1" composer:groupId="g1" composer:instanceIdx="1" composer:templateLineIdx="3" key="archivetune-translation-31"><span begin="2:41.569" end="2:41.855">Gave</span> <span begin="2:41.855" end="2:42.143">my</span> <span begin="2:42.143" end="2:42.431">feet</span> <span begin="2:42.431" end="2:42.717">the</span> <span begin="2:42.717" end="2:43.288">solid</span> <span begin="2:43.288" end="2:43.531">ground</span> <span begin="2:43.531" end="2:43.818">to</span> <span begin="2:43.818" end="2:44.395">stand</span></p><p begin="2:44.395" end="2:46.074" ttm:agent="v1" composer:groupId="g1" composer:instanceIdx="1" composer:templateLineIdx="4" key="archivetune-translation-32"><span begin="2:44.395" end="2:44.527">So</span> <span begin="2:44.527" end="2:44.680">let's</span> <span begin="2:44.680" end="2:44.967">sing</span> <span begin="2:44.967" end="2:46.074">together</span></p><p begin="2:45.854" end="2:49.544" ttm:agent="v1" composer:groupId="g1" composer:instanceIdx="1" composer:templateLineIdx="5" key="archivetune-translation-33"><span begin="2:45.854" end="2:46.423">Every</span> <span begin="2:46.423" end="2:46.711">light</span> <span begin="2:46.711" end="2:47.282">I'm</span> <span begin="2:47.282" end="2:47.569">giving</span> <span begin="2:47.569" end="2:48.139">all</span> <span begin="2:48.139" end="2:48.681">comes</span> <span begin="2:48.681" end="2:48.967">back</span> <span begin="2:48.967" end="2:49.257">to</span> <span begin="2:49.257" end="2:49.544">you</span></p><p begin="2:49.544" end="2:55.870" ttm:agent="v1" composer:groupId="g1" composer:instanceIdx="1" composer:templateLineIdx="6" key="archivetune-translation-34"><span begin="2:49.544" end="2:50.110">Comes</span> <span begin="2:50.110" end="2:50.395">back</span> <span begin="2:50.395" end="2:51.252">to</span> <span begin="2:51.252" end="2:55.870">you</span></p><p begin="3:01.056" end="3:06.441" ttm:agent="v1" composer:groupId="g1" composer:instanceIdx="2" composer:templateLineIdx="0" key="archivetune-translation-35"><span begin="3:01.056" end="3:01.340">You</span> <span begin="3:01.340" end="